{
  "name": "@rocketicons/mcp",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rocketicons-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "TELEMETRY.md",
    "TELEMETRY.pt-BR.md",
    "contracts/telemetry/v1"
  ],
  "scripts": {
