    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "ajv": "^8.20.0"
  }
}
