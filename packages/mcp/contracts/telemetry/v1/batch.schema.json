{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rocketicons:telemetry:batch:v1",
  "title": "Rocketicons optional telemetry batch, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "urn:rocketicons:telemetry:event:v1"
      }
    }
  }
}
