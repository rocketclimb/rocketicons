{
  "name": "@rocketicons/generator",
  "version": "0.7.0",
  "license": "MIT",
  "main": "./dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "if [ -z \"$SKIP_GENERATOR_BUILD\" ]; then npx ts-node ./src/build.ts; else echo \"[GENERATOR] skip icon generation - using pre-built icons\"; fi",
    "build-force": "npx ts-node ./src/build.ts",
    "clean": "rocketclimb-sh rm -fR dist core *.tsbuildinfo",
    "prebuild": "if [ -z \"$SKIP_GENERATOR_BUILD\" ]; then npm run fetch; else echo \"[GENERATOR] skip fetch\"; fi",
    "postbuild": "if [ -z \"$SKIP_GENERATOR_BUILD\" ]; then npm run copy-files; else echo \"[GENERATOR] skip copy-files\"; fi",
    "copy-files": "rocketclimb-sh cp -fR ../core/dist/* ../icons/core/ && rocketclimb-sh cp -fR ../tailwind/dist/* ../icons/tailwind/",
    "fetch": "npx ts-node ./src/fetcher.ts",
    "format": "prettier --check src/* --write --ignore-path ../../.gitignore",
    "lint": "eslint src/**/*",
    "rebuild": "npm run clean && npm run build-force",
    "refetch": "npx ts-node ./src/fetcher.ts --force",
    "test": "jest ./src --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "test:catalog": "node ./scripts/verify-catalog.cjs"
  },
  "devDependencies": {
    "@esm2cjs/p-queue": "7.3.0",
    "@primer/octicons": "^19.34.0",
    "@rocketicons/core": "*",
    "@rocketicons/tailwind": "*",
    "@types/react": "^18.2.72",
    "@types/react-dom": "^18.2.22",
    "feather-icons": "^4.29.2",
    "find-package": "^1.0.0",
    "glob-promise": "^6.0.5",
    "ionicons": "^4.6.3",
    "ionicons-5": "npm:ionicons@^5.5.4",
    "lucide-static": "^1.41.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native-svg": "15.1.0",
    "svgo": "^3.2.0"
  },
  "engines": {
    "npm": ">=6.0.0"
  }
}
