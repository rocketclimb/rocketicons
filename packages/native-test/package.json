{
  "name": "@rocketicons/native-test",
  "version": "0.6.1",
  "private": true,
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "export:ios": "expo export --platform ios --output-dir dist --source-maps",
    "smoke": "npm run export:ios && node ./scripts/verify-bundle.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx --ext .tsx"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "nativewind": "4.2.7",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "~3.16.1",
    "react-native-svg": "~15.15.5",
    "rocketicons": "file:../icons",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@types/react": "~18.3.0",
    "typescript": "~5.4.0"
  }
}
