{
  "files": [
    {
      "path": ".next/static/chunks/**/*.js",
      "maxSize": "150MB",
      "compression": "gzip"
    },
    {
      "path": ".next/static/css/**/*.css",
      "maxSize": "10MB",
      "compression": "gzip"
    },
    {
      "path": ".next/static/media/**/*",
      "maxSize": "50MB"
    },
    {
      "path": ".next/**/*",
      "maxSize": "220MB"
    }
  ],
  "ci": {
    "trackBranches": ["main", "master"],
    "repoBranchBase": "main"
  }
}
