SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ALGOLIA_APPLICATION_ID=your_algolia_application_id
NEXT_PUBLIC_ALGOLIA_SEARCH_ONLY_API_KEY=your_search_only_key

# Used only by `npm run indexer`; never expose this value to browser code.
ALGOLIA_INDEXING_API_KEY=your_restricted_indexing_key

# Optional. When set, layout.tsx mounts <GoogleAnalytics>; unset disables it.
NEXT_GOOGLE_ANALYTICS_ID=

# Optional. Overrides the default playground link in config/site.ts.
# NEXT_PUBLIC_PLAYGROUND_URL=https://playcode.io/1870276
