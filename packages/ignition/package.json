{
  "name": "ignition",
  "version": "0.4.4",
  "private": true,
  "scripts": {
    "prebuild": "npm run prebuild:cc && npm run prebuild:gs",
    "prebuild:cc": "test -z $SKIP_GENERATE_CONTENT_COLLECTIONS && npm run generate-content-collections || echo '[IGNITION] skip content collections generate'",
    "prebuild:gs": "test -z $SKIP_GENERATE_IGNITION_STATICS && npm run generate-statics || echo '[IGNITION] skip statics generate'",
    "build": "test -z $SKIP_IGNITION_BUILD && next build || echo '[IGNITION] skip build'",
    "build:analyze": "ANALYZE=true npm run build",
    "build:size-check": "npm run build && npm run size-check",
    "size-check": "node scripts/bundle-size-check.mjs",
    "size-report": "node scripts/bundle-size-report.mjs",
    "size-compare": "node scripts/bundle-size-compare.mjs",
    "size-server": "node scripts/bundle-analyzer-server.mjs",
    "optimization:baseline": "node scripts/bundle-optimization-tracker.mjs baseline",
    "optimization:compare": "node scripts/bundle-optimization-tracker.mjs compare",
    "optimization:record": "node scripts/bundle-optimization-tracker.mjs record",
    "optimization:history": "node scripts/bundle-optimization-tracker.mjs history",
    "optimization:suggest": "node scripts/bundle-optimization-tracker.mjs suggest",
    "install:auth": "npm config set @rocketclimb:registry https://npm.pkg.github.com && npm config set //npm.pkg.github.com/:_authToken $GITHUB_TOKEN && npm ci",
    "build:with-auth": "npm run install:auth && npm run build",
    "build:size-check:auth": "npm run install:auth && npm run build && npm run size-check",
    "install:with-auth": "./scripts/install-with-auth.sh",
    "build:with-bundle-check": "./scripts/build-with-bundle-check.sh",
    "predev": "npm run generate-content-collections && npm run generate-statics",
    "dev": "next dev",
    "predev:all-icons": "npm run generate-content-collections && npm run generate-statics:all-icons",
    "dev:all-icons": "NEXT_PUBLIC_VERCEL_ENV=develop next dev",
    "generate-statics": "npx ts-node -r tsconfig-paths/register ./src/statics-generator",
    "generate-content-collections": "rocketclimb-cc",
    "generate-statics:all-icons": "NEXT_PUBLIC_VERCEL_ENV=develop npm run generate-statics",
    "indexer": "npx ts-node -r tsconfig-paths/register ./src/algolia-indexer",
    "lint": "next lint",
    "format": "prettier --check src/* --write --ignore-path ../../.gitignore",
    "rebuild": "rm -fR .content-collections && next build",
    "start": "next start",
    "deploy:install": "./scripts/install-with-auth.sh",
    "deploy:build": "./scripts/build-with-bundle-check.sh"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "^14.1.4",
    "@next/third-parties": "^14.1.4",
    "@rocketclimb/code-block": "^0.1.0",
    "@rocketclimb/content-collections": "^0.1.3",
    "@shikijs/rehype": "1.3.0",
    "@vercel/analytics": "^1.2.2",
    "@vercel/edge-config": "^1.1.0",
    "algoliasearch": "^4.23.3",
    "change-case": "^5.4.4",
    "next": "^14.2",
    "react": "~18.2",
    "react-dom": "~18.2",
    "react-instantsearch": "^7.7.2",
    "rehype-slug-custom-id": "^1.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^4.0.0",
    "rocketicons": "*",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.3",
    "@types/adm-zip": "^0.5.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "~18.2",
    "@types/react-dom": "~18.2",
    "autoprefixer": "^10.4.19",
    "chalk": "^4.1.2",
    "eslint-config-next": "14.2.3",
    "filesize": "^10.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.3"
  }
}
