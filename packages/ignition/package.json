{
  "name": "ignition",
  "version": "0.4.4",
  "private": true,
  "scripts": {
    "prebuild": "npm run prebuild:cc && npm run prebuild:gs",
    "prebuild:cc": "if [ -z \"$SKIP_GENERATE_CONTENT_COLLECTIONS\" ]; then npm run generate-content-collections; else echo '[IGNITION] skip content collections generate'; fi",
    "prebuild:gs": "if [ -z \"$SKIP_GENERATE_IGNITION_STATICS\" ]; then npm run generate-statics; else echo '[IGNITION] skip statics generate'; fi",
    "build": "if [ -z \"$SKIP_IGNITION_BUILD\" ]; then next build; else echo '[IGNITION] skip build'; fi",
    "predev": "npm run generate-content-collections && npm run generate-statics",
    "dev": "next dev",
    "predev:all-icons": "npm run generate-content-collections && npm run generate-statics:all-icons",
    "dev:all-icons": "RI_GENERATE_ALL_ICONS=true next dev",
    "generate-statics": "npx ts-node -r tsconfig-paths/register ./src/statics-generator",
    "generate-content-collections": "rocketclimb-cc",
    "generate-statics:all-icons": "RI_GENERATE_ALL_ICONS=true npm run generate-statics",
    "indexer": "npx ts-node -r tsconfig-paths/register ./src/algolia-indexer",
    "test": "jest ./src --passWithNoTests",
    "lint": "next lint",
    "format": "prettier --check src/* --write --ignore-path ../../.gitignore",
    "rebuild": "rm -fR .content-collections && next build",
    "start": "next start"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "^14.1.4",
    "@next/third-parties": "^14.1.4",
    "@rocketclimb/code-block": "^0.1.0",
    "@rocketclimb/content-collections": "^0.1.3",
    "@shikijs/rehype": "1.3.0",
    "algoliasearch": "^4.23.3",
    "change-case": "^5.4.4",
    "next": "^14.2",
    "react": "~18.2",
    "react-dom": "~18.2",
    "react-instantsearch": "^7.7.2",
    "rehype-slug-custom-id": "^1.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^4.0.0",
    "rocketicons": "*"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "~18.2",
    "@types/react-dom": "~18.2",
    "autoprefixer": "^10.4.19",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.3"
  }
}
