{
  "name": "rocketclimb-icons",
  "version": "0.4.5",
  "description": "React / React Native powered by tailwind",
  "keywords": [
    "icons",
    "react",
    "react-native",
    "tailwind",
    "nativewind"
  ],
  "homepage": "https://github.com/rocketclimb/rocketicons#readme",
  "bugs": {
    "url": "https://github.com/rocketclimb/rocketicons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocketclimb/rocketicons.git"
  },
  "license": "MIT",
  "author": "amorimjj",
  "main": "dist/index.js",
  "workspaces": [
    "packages/core",
    "packages/tailwind",
    "packages/generator",
    "packages/icons",
    "packages/ignition"
  ],
  "scripts": {
    "build-all": "test -z $SKIP_BUILD_ALL && npm run build --workspaces --if-present || echo '[ROCKETCLIMB-ICONS] skip build-all'",
    "build-all-with-icons": "npm run build --workspaces --if-present",
    "clean-all": "npm run clean --workspaces --if-present",
    "prepare": "husky && npm run clean-all && npm run build-all",
    "test-all": "npm run test --workspaces --if-present",
    "format-all": "npm run format --workspaces --if-present",
    "lint-all": "npm run lint --workspaces --if-present",
    "release": "npx rocketclimb-sh releaser",
    "start": "npm run start -w packages/ignition",
    "build": "npm run build -w packages/ignition",
    "build-static-full": "GENERATE_ALL_ICONS=true npm run build -w packages/ignition",
    "build-static-sample": "GENERATE_SAMPLE_ICONS=true npm run build -w packages/ignition",
    "vercel-build-static": "SKIP_GENERATOR_BUILD=true GENERATE_ALL_ICONS=true npm run build -w packages/core packages/tailwind packages/ignition",
    "generate-icons": "npm run build -w packages/generator",
    "generate-icons-force": "npm run refetch -w packages/generator && npm run build -w packages/generator"
  },
  "dependencies": {
    "next": "^14.2"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.16.0",
    "@aws-amplify/backend-cli": "^1.7.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@jest/globals": "^29.7.0",
    "@next/bundle-analyzer": "^15.4.0-canary.51",
    "@rocketclimb/sh": "0.1.32",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "conventional-commits-parser": "^5.0.0",
    "eslint-plugin-react": "^7.34.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "nativewind": "2.0.11",
    "prettier": "^3.2.5",
    "tailwindcss": "3.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-replace-paths": "^0.0.14",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.+(ts|tsx)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.+(json|css|md)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
